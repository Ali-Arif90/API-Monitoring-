# Frontend environment configuration for the dashboard
# When deploying, set the backend API URL if the frontend is hosted separately.

VITE_API_BASE_URL=/api
VITE_BASE_PATH=/

# Example when backend is deployed separately:
# VITE_API_BASE_URL=https://api-monitoring-backend.onrender.com/api

# Example for GitHub Pages deployment to a repo named API-Monitoring-:
# VITE_BASE_PATH=/API-Monitoring-/
